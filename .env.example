# RationSaathi environment configuration — placeholders only. Never commit real credentials.

# --- Database ---
# PostgreSQL (production target):
#DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rationsaathi
# SQLite (local demo default, used when unset):
DATABASE_URL=sqlite:///backend/var/rationsaathi.db

# --- Demo behaviour ---
DEMO_MODE=true
# Only the labelled simulated submission adapter runs while this is true.
ALLOW_SIMULATED_SUBMISSION=true

# --- Sessions ---
SESSION_TTL_MINUTES=45
FACILITATOR_SESSION_TTL_MINUTES=15
MAX_ACTIVE_SESSIONS_PER_HOUSEHOLD=25

# --- Rules & privacy ---
RULES_VERSION=synthetic-2026.1
# Minimum group size (k) for public aggregate suppression.
AGGREGATE_MIN_GROUP_SIZE=5

# --- Frontend origin allowed by CORS (Vite dev server) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend build-time API base (Vite) ---
#VITE_API_BASE=/api/v1
#VITE_API_PROXY=http://localhost:8000
